# Copied into the process env; Nuxt maps these onto runtimeConfig (see nuxt.config.ts).
# In app/server code use useRuntimeConfig() — do not read process.env there.
# drizzle-kit (CLI) is the exception: it reads process.env.NUXT_* directly.

# server-only → runtimeConfig.authSecret
NUXT_AUTH_SECRET=

# server-only → runtimeConfig.tursoDatabaseUrl / tursoAuthToken
NUXT_TURSO_DATABASE_URL=
NUXT_TURSO_AUTH_TOKEN=

# public → runtimeConfig.public.partyHost
NUXT_PUBLIC_PARTY_HOST=
